# Tata AIG voice demo — environment variables
# Copy this file to .env (local dev) and fill in real values. Never commit the real .env.

# --- Database (required) ---------------------------------------------------
# Postgres connection string Prisma reads via prisma/schema.prisma. Railway/Neon/Supabase
# all provide one in this shape: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/tata_aig_voice"

# --- NuPlay / Nurix voice gateway (required for live calls) ----------------
# Base host for the NuPlay web-call API. Only override if NuPlay gives you a different host.
NURIX_API_BASE="https://agentx-prod.nurixlabs.tech"

# Account-shared gateway key used for both the server-side call path (src/lib/nurix.ts)
# AND the browser-side call path (VoiceAgent.tsx / useVoiceCall.ts, which read the
# NEXT_PUBLIC_-prefixed copy below). It is account-shared, not per-widget — see the
# comments in src/lib/nurix.ts and src/components/VoiceAgent.tsx for why it must ship
# in the client bundle on this host.
NURIX_GATEWAY_API_KEY="replace-with-real-gateway-key"
NEXT_PUBLIC_NURIX_GATEWAY_API_KEY="replace-with-real-gateway-key"

# Smart Coach / Ananya — sales-training role-play agent (inbound). Server-side default
# lives in src/lib/nurix.ts; client-side default lives in VoiceAgent.tsx / useVoiceCall.ts.
# Both fall back to the real Tata AIG agent ID if this is unset, but set it explicitly
# per-environment so a staging/prod split is possible later.
NURIX_COACH_AGENT_ID="a6874aeb-8061-43e7-bb0b-7515dbfa115a"
NEXT_PUBLIC_NURIX_COACH_AGENT_ID="a6874aeb-8061-43e7-bb0b-7515dbfa115a"

# Lead Qualifier / Riya — outbound qualification agent.
NURIX_QUALIFIER_AGENT_ID="fbad08b6-4f3f-48ec-ac6b-056c6ba536fe"
NEXT_PUBLIC_NURIX_QUALIFIER_AGENT_ID="fbad08b6-4f3f-48ec-ac6b-056c6ba536fe"

# --- Claude / Anthropic (optional) ------------------------------------------
# When unset, src/lib/ai.ts falls back to deterministic canned copy so the demo still
# works fully offline. Set both to enable live Claude-generated copilot text.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
